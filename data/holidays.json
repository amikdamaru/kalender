    "skb-2021": {
      "title": "Keputusan Bersama Menteri Agama, Menteri Ketenagakerjaan, dan Menteri PANRB tentang Hari Libur Nasional dan Cuti Bersama Tahun 2021 (SKB Nomor 642 Tahun 2020, Nomor 4 Tahun 2020, Nomor 4 Tahun 2020) beserta perubahannya, terakhir SKB Nomor 712 Tahun 2021, Nomor 1 Tahun 2021, Nomor 3 Tahun 2021",
      "issuedDate": "2021-06-18",
      "urls": [
        "https://www.kemenkopmk.go.id/sites/default/files/artikel/2021-07/PEMERINTAH%20UBAH%20HARI%20LIBUR%20NASIONAL%20DAN%20HAPUS%20CUTI%20BERSAMA%20HARI%20NATAL%202021.pdf",
        "https://news.detik.com/berita/d-5785133/cuti-natal-dihapus-ini-imbauan-pemerintah-agar-tak-pulang-kampung"
      ],
      "verification": "verified_secondary",
      "notes": "Perubahan Juni 2021: Tahun Baru Islam 1443 H digeser dari 10 ke 11 Agustus, Maulid Nabi dari 19 ke 20 Oktober, cuti bersama Natal 24 Desember ditiadakan. Tanggal 18 Juni 2021 adalah tanggal pengumuman Menko PMK. Daftar akhir dicocokkan dengan siaran pers Kemenko PMK dan pemberitaan yang mengutip SKB; PDF resmi berupa hasil pindaian."
    },
    "skb-2022": {
      "title": "Keputusan Bersama Menteri Agama, Menteri Ketenagakerjaan, dan Menteri PANRB Nomor 963 Tahun 2021, Nomor 3 Tahun 2021, Nomor 4 Tahun 2021 tentang Hari Libur Nasional dan Cuti Bersama Tahun 2022, beserta perubahan pertama (Nomor 375 Tahun 2022, Nomor 1 Tahun 2022, Nomor 1 Tahun 2022; 7 April 2022) dan perubahan kedua (7 Juli 2022)",
      "issuedDate": "2021-09-22",
      "urls": [
        "https://setkab.go.id/inilah-skb-3-menteri-perubahan-hari-libur-nasional-dan-cuti-bersama-tahun-2022/",
        "https://www.menpan.go.id/site/berita-terkini/skb-tiga-menteri-tetapkan-perubahan-hari-libur-nasional-iduladha-1443-hijriah-dari-9-juli-2022-menjadi-10-juli-2022",
        "https://kemenkopmk.go.id/node/1865"
      ],
      "verification": "verified_official",
      "notes": "Perubahan pertama menambahkan cuti bersama Idulfitri 29 April, 4, 5, 6 Mei. Perubahan kedua memindahkan libur Iduladha 1443 H dari 9 Juli menjadi 10 Juli 2022."
    },
    "skb-2023": {
      "title": "Keputusan Bersama Menteri Agama, Menteri Ketenagakerjaan, dan Menteri PANRB Nomor 1066 Tahun 2022, Nomor 3 Tahun 2022, Nomor 3 Tahun 2022 tentang Hari Libur Nasional dan Cuti Bersama Tahun 2023, beserta perubahan pertama (Nomor 327 Tahun 2023, Nomor 1 Tahun 2023, Nomor 1 Tahun 2023; 29 Maret 2023) dan perubahan kedua (Nomor 624 Tahun 2023, Nomor 2 Tahun 2023, Nomor 2 Tahun 2023; 16 Juni 2023)",
